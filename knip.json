{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "artifacts/preventivo-ai/public/widget.js",
    "artifacts/pocket/**",
    "docs/pocket-design/**"
  ],
  "ignoreDependencies": [
    "prettier",
    "pdfkit",
    "pdf-parse",
    "mammoth",
    "xlsx",
    "@google/genai",
    "@types/pdf-parse",
    "@fontsource-variable/figtree"
  ],
  "ignoreIssues": {
    "artifacts/preventivo-ai/src/components/ui/**": [
      "exports",
      "types"
    ]
  },
  "rules": {
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn",
    "enumMembers": "warn",
    "duplicates": "warn",
    "catalog": "warn"
  },
  "workspaces": {
    ".": {
      "entry": [
        "api/index.js"
      ]
    },
    "artifacts/api-server": {
      "entry": [
        "src/index.ts",
        "src/app.ts",
        "src/**/*.test.ts",
        "src/e2e/**",
        "scripts/*.ts",
        "vitest.e2e.config.ts",
        "vitest.e2e.setup.ts"
      ]
    },
    "artifacts/preventivo-ai": {
      "entry": [
        "index.html",
        "scripts/*.ts",
        "server/*.mjs",
        "public/sw.js",
        "src/entry-server.tsx"
      ]
    },
    "scripts": {
      "entry": [
        "src/*.ts"
      ]
    },
    "lib/db": {
      "drizzle": false,
      "entry": [
        "drizzle.config.ts"
      ]
    }
  }
}
